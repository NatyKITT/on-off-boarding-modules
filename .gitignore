# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# local env files - secrets, never commit
.env
.env.local
.env*.local
.env.production
.env.development
.env.test
.env.sentry-build-plugin
.vscode.env

# keep env examples in git
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# auto-generated at build time (scripts/build-info.mjs)
/src/build-info.ts

# email
/.react-email/

# Sentry Config File
.env.sentry-build-plugin

# AI agents - local/private config
.claude/local.json
.claude/*.local.json

# secrets / certificates / private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr

# local scripts with secrets
*.local.sh
*-local.sh

# idea / WebStorm
.idea/
